<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>ebs-wees-bill: third-party licenses</title>
<style>
body { font: 15px/1.5 sans-serif; max-width: 920px; margin: 0 auto; padding: 24px; }
pre { background: #f2f2f2; padding: 12px; white-space: pre-wrap; font-size: 13px; }
section { border-top: 1px solid #ddd; margin-top: 24px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>ebs-wees-bill is licensed under MIT OR Apache-2.0 (see LICENSE-MIT and LICENSE-APACHE). The release binary also contains the Rust crates below; each is used under the license named here, and the license text follows.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a>: {{count}} crate(s)</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
